{
  "name": "octo-core",
  "version": "1.3.1",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:ollama": "vitest run --config vitest.ollama.config.ts",
    "test:replay": "vitest run --config vitest.replay.config.ts",
    "test:desktop:windows": "node scripts/gates/track-pending.ts B",
    "test:anthropic": "vitest run --config vitest.anthropic.config.ts",
    "test:model:live": "vitest run --config vitest.openrouter.config.ts",
    "gate": "tsx scripts/gates/run.ts",
    "gate:all": "tsx scripts/gates/run.ts --all",
    "gate:release": "tsx scripts/gates/run.ts --release",
    "scan:secrets": "tsx scripts/gates/scan-secrets.ts",
    "check:licenses": "tsx scripts/gates/check-licenses.ts",
    "package:win": "tsx scripts/package-win.ts",
    "package:release": "tsx scripts/package-release.ts",
    "site:screenshots": "tsx scripts/site/screenshots.ts",
    "site:releases": "tsx scripts/site/releases-json.ts",
    "site:check": "tsx scripts/site/check-site.ts",
    "site:preview": "python3 -m http.server 4173 --directory site"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "devDependencies": {
    "@electron/packager": "18.4.4",
    "@octo/capture-adapter": "workspace:*",
    "@octo/contracts": "workspace:*",
    "@octo/desktop": "workspace:*",
    "@octo/engine": "workspace:*",
    "@octo/test-fixtures": "workspace:*",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.4",
    "eslint": "10.11.0",
    "playwright": "1.63.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
